# =============================================================================
# Suricata IDS Rules — Adversary-in-a-Box Lab
# Custom detection rules for all red team campaigns
# =============================================================================

# ---------------------------------------------------------------------------
# RECONNAISSANCE — T1595 Active Scanning
# ---------------------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Nmap SYN Stealth Scan"; flags:S; threshold:type threshold,track by_src,count 20,seconds 1; classtype:attempted-recon; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Port Scan Detected - 10 ports in 5 sec"; flags:S; threshold:type threshold,track by_src,count 10,seconds 5; classtype:attempted-recon; sid:1000002; rev:1;)
# G5.4 (Gap J): the old rule keyed on 5 raw bytes at a fixed offset --
# byte 0 is the DNS transaction ID, so this could only ever match a query
# whose ID happened to be exactly 0x0000, never a real version-scan probe.
# Real version-scan tooling (dig, nmap's dns-nsid, etc.) queries the CHAOS
# class for TXT version.bind/version.server; match that against the proper
# dns.query sticky buffer instead of guessing at header bytes.
alert dns any any -> $HOME_NET 53 (msg:"ET RECON DNS Version Scan (CHAOS version.bind)"; dns.query; content:"version.bind"; nocase; classtype:attempted-recon; sid:1000003; rev:2;)

# ---------------------------------------------------------------------------
# INITIAL ACCESS — T1566 Phishing | T1190 Web Exploit
# ---------------------------------------------------------------------------
alert smtp any any -> $HOME_NET 25 (msg:"ET PHISHING Suspicious Email - Executable Attachment"; content:"Content-Disposition: attachment"; content:"filename="; pcre:"/filename=\"[^\"]*\.(exe|bat|ps1|vbs|js|hta|pdf|doc|docm|zip|iso)\"/i"; classtype:social-engineering; sid:1000010; rev:2;)
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER SQL Injection Attempt OR 1=1"; content:"' OR"; http_uri; nocase; classtype:web-application-attack; sid:1000020; rev:1;)
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER XSS Attempt Script Tag"; content:"<script>"; http_uri; nocase; classtype:web-application-attack; sid:1000021; rev:1;)
# G5.4 (Gap J, found while building G5.1's harness -- not in the original
# issue text, but the same class of bug): http_uri is libhtp's NORMALIZED
# uri buffer, which resolves "../" away before this content match ever ran,
# so the rule could not fire against any real traversal request. Confirmed
# empirically: swapping to http_raw_uri (the un-decoded wire bytes) fires
# correctly against the exact literal-".." payload red-team's own
# exploit_web.py sends.
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER Path Traversal Attempt"; content:"../"; http_raw_uri; classtype:web-application-attack; sid:1000022; rev:2;)
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER SQLi UNION SELECT"; content:"UNION SELECT"; http_uri; nocase; classtype:web-application-attack; sid:1000023; rev:1;)
# G5.3 (Gap I): the four rules above only look at http_uri (the GET query
# string) or, for sid:1000010, raw SMTP payload -- none of them match the
# same payload sent as a POST body, which the lab's own campaigns and any
# real attacker use just as often. http-body-inline is already on
# (suricata.yaml's libhtp config), so http.request_body is populated.
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER SQL Injection Attempt OR 1=1 (request body)"; http.request_body; content:"' OR"; nocase; classtype:web-application-attack; sid:1000024; rev:1;)
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER XSS Attempt Script Tag (request body)"; http.request_body; content:"<script>"; nocase; classtype:web-application-attack; sid:1000025; rev:1;)
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER SQLi UNION SELECT (request body)"; http.request_body; content:"UNION SELECT"; nocase; classtype:web-application-attack; sid:1000026; rev:1;)
# G5.3 (Gap I): red-team's exploit_web.py hits GET /file?name=<path> for its
# path-traversal test (both a literal "../../../etc/passwd" and a
# "..%2F..%2F..%2Fetc%2Fpasswd" URL-encoded variant). sid:1000022 only ever
# sees the literal form (http_raw_uri, its buffer as of G5.4, is un-decoded
# so "%2F" never becomes "/" there) -- an absolute-path-read endpoint being
# hit at all, with any encoding, is itself the signal worth alerting on.
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER Absolute Path File Read"; content:"/file?name="; http_uri; classtype:web-application-attack; sid:1000027; rev:1;)

# ---------------------------------------------------------------------------
# PRIVILEGE ESCALATION — T1548
# ---------------------------------------------------------------------------
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ET EXPLOIT Possible Privilege Escalation sudo -l enumeration"; content:"sudo"; content:"-l"; classtype:attempted-admin; sid:1000030; rev:1;)

# ---------------------------------------------------------------------------
# LATERAL MOVEMENT — T1550.002 Pass the Hash | T1563.001 SSH Hijack
# ---------------------------------------------------------------------------
alert tcp any any -> $HOME_NET 445 (msg:"ET LATERAL_MOVEMENT SMB Pass-the-Hash Attempt"; content:"|FF|SMB"; depth:5; classtype:policy-violation; sid:1000040; rev:1;)
# G5.4 (Gap J): |FF|SMB is the SMB1 protocol magic; real-world SMB traffic
# today, including any modern pass-the-hash tooling (impacket, etc.), is
# SMB2/3, whose magic is |FE|SMB -- the original rule could never fire
# against traffic any current tool actually sends. Add the SMB2 magic as
# its own rule (both can legitimately coexist for older mixed environments)
# and enable the smb app-layer parser (below, suricata.yaml) for visibility
# even where no sid is written against it yet.
alert tcp any any -> $HOME_NET 445 (msg:"ET LATERAL_MOVEMENT SMB2 Pass-the-Hash Attempt"; content:"|FE|SMB"; depth:4; classtype:policy-violation; sid:1000043; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"ET LATERAL_MOVEMENT Multiple SSH Authentication Failures"; threshold:type both,track by_src,count 5,seconds 30; classtype:attempted-user; sid:1000041; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"ET LATERAL_MOVEMENT Internal SSH Connection - Possible Hijacking"; classtype:policy-violation; sid:1000042; rev:1;)

# ---------------------------------------------------------------------------
# EXFILTRATION — T1048.003 DNS Tunnel | T1041 HTTPS C2
# ---------------------------------------------------------------------------
# audit-4 G3d: rules keyed on $EXTERNAL_NET (the HTTPS-C2 beacon and the
# reverse-shell / Metasploit sigs below) CANNOT fire in this lab. lab-net is
# `internal: true` (air-gapped), so there is no EXTERNAL_NET an in-lab host
# can reach -- the T1041 https_exfil campaign never crosses one. They are
# kept as production-reference templates. The LIVE detection path for T1041
# is the syslog Sigma rule exfil_https.yml (audit-4 G2b ships the campaign's
# advisory over syslog), plus Zeek for the DNS-tunnel side. See
# docs/mitre-attack-map.md.
# G5.4 (Gap J): the old rule's 10-byte content match had no `offset`, so it
# was anchored at byte 0 of the UDP payload -- i.e. the DNS transaction ID
# itself, not the flags/QDCOUNT fields the byte pattern was meant to check
# (those start at byte 2). No protocol-valid DNS query (which needs
# QDCOUNT=1 to even pass Suricata's dns probing parser and be evaluated as
# a dns-typed rule at all) could also satisfy this rule's byte-0 anchor.
# Match the long-subdomain pattern against the proper dns.query sticky
# buffer instead, which sidesteps header-byte guessing entirely.
alert dns any any -> any 53 (msg:"ET DNS_TUNNEL Long DNS Subdomain - Possible Tunneling"; dns.query; pcre:"/^[a-z2-7]{30,}\./i"; classtype:trojan-activity; sid:1000050; rev:2;)
alert dns any any -> any 53 (msg:"ET DNS_TUNNEL High DNS Query Rate"; threshold:type threshold,track by_src,count 50,seconds 10; classtype:trojan-activity; sid:1000051; rev:1;)
# (reference only -- cannot fire on air-gapped lab-net; see note above)
# G5.4 (Gap J): rewritten onto the http.user_agent sticky buffer instead of
# matching the literal "User-Agent:" header name via http_header + a pcre
# re-searching for it -- the old form worked but re-derived, less reliably,
# what http.user_agent already isolates for exactly this purpose.
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET C2 Suspicious HTTPS Beacon - Non-standard User-Agent"; http.user_agent; pcre:"/^(?!.*(Mozilla|Chrome|Safari|curl|python))/"; classtype:trojan-activity; sid:1000052; rev:2;)

# ---------------------------------------------------------------------------
# PERSISTENCE — T1053.003 Cron | T1098.004 SSH Keys
# ---------------------------------------------------------------------------
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ET PERSISTENCE Crontab Modification Detected"; content:"crontab"; classtype:policy-violation; sid:1000060; rev:1;)

# ---------------------------------------------------------------------------
# MALWARE / GENERAL
# ---------------------------------------------------------------------------
# audit-4 G3d: reference only -- $EXTERNAL_NET can't exist on air-gapped
# lab-net, so these never fire here (see the EXFILTRATION note above).
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ET MALWARE Reverse Shell Connection Attempt"; content:"/bin/bash"; content:"-i"; classtype:trojan-activity; sid:1000070; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"ET MALWARE Metasploit Default Port C2 Beacon"; classtype:trojan-activity; sid:1000071; rev:1;)

# ---------------------------------------------------------------------------
# Phase B B1a -- T1557 Adversary-in-the-Middle (lab simulation)
# PRODUCTION-REFERENCE ONLY -- does NOT fire on the lab simulation (P2).
# MitmCampaign emits its "LAB-SIMULATION: attacker" marker over the UDP syslog
# advisory (logstash:5514), not as a tcp payload, so this tcp rule never
# matches in-lab. The LIVE, SCORED detection for T1557 is the paired Sigma rule
# mitm_arp_spoof.yml, which the scoreboard now evaluates against the syslog-*
# advisory (P1). Kept as a reference for what the technique looks like on a real
# wire.
# ---------------------------------------------------------------------------
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ET MITM Lab Simulation ARP Spoof Advisory"; content:"LAB-SIMULATION: attacker"; classtype:policy-violation; sid:1000080; rev:1;)

# ---------------------------------------------------------------------------
# Phase B B1b -- T1110 Brute Force (HTTP login form)
# Complements the existing SSH brute-force rule (sid:1000041). Threshold
# fires on a burst of POST /login from a single source.
# ---------------------------------------------------------------------------
alert http any any -> $HOME_NET any (msg:"ET BRUTE_FORCE HTTP Login Burst"; flow:established,to_server; content:"POST"; http_method; content:"/login"; http_uri; threshold:type threshold,track by_src,count 5,seconds 60; classtype:attempted-user; sid:1000090; rev:1;)

# ---------------------------------------------------------------------------
# Phase B B1c -- T1204 User Execution / Malware Drop (EICAR marker)
# PRODUCTION-REFERENCE ONLY -- does NOT fire on the lab simulation (P2).
# MalwareDropCampaign writes EICAR to disk (/tmp/lab_malware_drop.eicar) and
# emits the marker over the UDP syslog advisory, never as a tcp payload on the
# wire, so this rule does not match in-lab. The LIVE, SCORED detection for T1204
# is the paired Sigma rule malware_drop_eicar.yml, evaluated by the scoreboard
# against syslog-* (P1). Kept as a reference for the network-transport path a
# real drop would take.
# ---------------------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"ET MALWARE EICAR Test Marker In Transit"; content:"EICAR-STANDARD-ANTIVIRUS-TEST-FILE"; classtype:trojan-activity; sid:1000100; rev:1;)

# ---------------------------------------------------------------------------
# Phase B B1d -- T1486 Data Encrypted for Impact (ransomware sim)
# PRODUCTION-REFERENCE ONLY -- does NOT fire on the lab simulation (P2).
# RansomwareSimCampaign renames decoys + writes the note to disk and emits the
# marker over the UDP syslog advisory; the note text never crosses the wire as a
# tcp payload, so this rule does not match in-lab. The LIVE, SCORED detection for
# T1486 is the paired Sigma rule impact_ransomware.yml, evaluated by the
# scoreboard against syslog-* (P1). Kept as a reference for lateral distribution
# of the note (e.g. over an SMB share) in a real incident.
# ---------------------------------------------------------------------------
alert tcp $HOME_NET any -> $HOME_NET any (msg:"ET RANSOMWARE Lab Ransom Note Marker"; content:"LAB SIMULATION -- NO ACTUAL ENCRYPTION"; classtype:trojan-activity; sid:1000110; rev:1;)

# ---------------------------------------------------------------------------
# Phase G3.5 -- containment tripwire
# The belt to G3.1 (static compose config check) and G3.2 (live containment
# probe)'s suspenders: those two prove the air-gap holds by inspection, but
# nothing was actually watching the wire for the exact failure mode Phase 3
# exists to prevent. This fires on ANY lab host traffic reaching a non-lab
# address, regardless of technique or cause (misconfigured network driver,
# an escaped campaign, a manual mistake) -- it does not try to distinguish
# them, since any of them means containment already failed.
# ---------------------------------------------------------------------------
alert ip $HOME_NET any -> !$HOME_NET any (msg:"AIB CONTAINMENT lab host reached non-lab address"; classtype:policy-violation; sid:1000200; rev:1;)
